<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="wrap_content"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_height="wrap_content">
	<RelativeLayout
		android:layout_centerInParent="true"
		android:layout_marginLeft="30dp"
		android:layout_marginRight="30dp"
		android:background="@drawable/fly_verify_popup_dialog_bg"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<TextView
			android:id="@+id/fly_verify_alert_dialog_title"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="@dimen/fly_verify_text_size_m"
			android:layout_centerHorizontal="true"
			android:textColor="@color/fly_verify_text_color_common_black"
			android:layout_marginTop="10dp"
			android:text="温馨提示"/>
		<TextView
			android:id="@+id/fly_verify_alert_dialog_text"
			android:layout_marginTop="10dp"
			android:layout_marginBottom="10dp"
			android:layout_marginLeft="20dp"
			android:layout_marginRight="20dp"
			android:textColor="@color/fly_verify_text_color_common_black"
			android:layout_below="@+id/fly_verify_alert_dialog_title"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			tools:text="登录即视为同意《运营商服务协议》和《自有用户协议》、《自有隐私政策》"
			/>
		<View
			android:id="@+id/fly_verify_divider"
			android:layout_below="@+id/fly_verify_alert_dialog_text"
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="@color/fly_verify_text_color_common_gray_light"
			/>
		<View
			android:id="@+id/fly_verify_divider1"
			android:layout_width="1dp"
			android:layout_height="40dp"
			android:layout_centerHorizontal="true"
			android:layout_below="@id/fly_verify_divider"
			android:background="@color/fly_verify_text_color_common_gray_light"
			/>

		<TextView
			android:id="@+id/fly_verify_alert_dialog_cancel"
			android:layout_width="match_parent"
			android:layout_height="40dp"
			android:gravity="center"
			android:textColor="@color/fly_verify_text_color_common_black"
			android:layout_below="@+id/fly_verify_divider"
			android:layout_toLeftOf="@+id/fly_verify_divider1"
			android:text="取消"/>
		<TextView
			android:id="@+id/fly_verify_alert_dialog_allow"
			android:layout_width="match_parent"
			android:layout_height="40dp"
			android:gravity="center"
			android:textColor="@color/fly_verify_text_color_common_black"
			android:layout_below="@+id/fly_verify_divider"
			android:layout_toRightOf="@+id/fly_verify_divider1"
			android:text="同意并登录"/>

	</RelativeLayout>
</RelativeLayout>